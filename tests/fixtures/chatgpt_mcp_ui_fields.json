{
  "schema": 1,
  "description": "Per tool of the Autonom MCP adapter, the dotted field paths a workspace page reads (contract run ws-p3-mcp-adapter, sections 2-5 and 8). Paths go into structuredContent; 'name[]' walks every item of a non-empty list; a present null counts as present. tests/test_chatgpt_mcp_package.py checks each path against real server results (fake CLI and fake Canvas) and runs the page parsers of workspace-dev-core.mjs over the same results.",
  "envelope": ["schema_version", "operation_id", "tool", "ok", "outcome", "host_id", "warnings"],
  "failure": ["error_code", "error", "hint", "retry_safe"],
  "tools": {
    "list_hosts": ["hosts[].host_id", "hosts[].name", "hosts[].kind", "hosts[].version", "hosts[].state",
                   "hosts[].capabilities.sessions", "hosts[].capabilities.control", "hosts[].capabilities.flows",
                   "hosts[].capabilities.artifacts", "hosts[].capabilities.media.transport",
                   "hosts[].capabilities.media.codec", "hosts[].capabilities.input"],
    "open_workspace": ["workspace.adapter_version", "workspace.host_id", "workspace.hosts[].host_id",
                       "workspace.hosts[].name", "workspace.hosts[].kind", "workspace.hosts[].state",
                       "workspace.hosts[].capabilities.media.transport", "workspace.sessions[].host_id",
                       "workspace.sessions[].session_id", "workspace.sessions[].platform",
                       "workspace.sessions[].target_id", "workspace.sessions[].label", "workspace.sessions[].live"],
    "save_diagnostics": ["saved.run_id", "saved.bytes"],
    "list_devices": ["devices[].host_id", "devices[].platform", "devices[].target_id", "devices[].name",
                     "devices[].state", "devices[].avd", "devices[].session_id"],
    "list_sessions": ["sessions[].host_id", "sessions[].session_id", "sessions[].platform", "sessions[].target_id",
                      "sessions[].label", "sessions[].live", "sessions[].started_at", "sessions[].stopped_at",
                      "sessions[].started_by"],
    "get_session": ["session.host_id", "session.session_id", "entry.platform", "entry.target_id", "entry.label",
                    "entry.live", "entry.started_at", "entry.stopped_at", "control.state", "control.holder",
                    "control.generation", "control.expires_at", "control.mine", "control.role",
                    "control.took_over_from", "streams[].stream_id", "streams[].profile", "active_run_id", "busy"],
    "start_session": ["session.host_id", "session.session_id", "entry.session_id", "entry.platform",
                      "entry.target_id", "entry.label", "entry.live", "entry.started_at", "created"],
    "stop_session": ["session.host_id", "session.session_id", "stopped", "hooks[].name", "hooks[].ok",
                     "hooks[].detail"],
    "get_screen": ["session.session_id", "screen.artifact_id", "screen.width", "screen.height", "screen.bytes",
                   "screen.mime", "screen.inline"],
    "get_ui_tree": ["session.session_id", "nodes", "node_count", "truncated", "screen"],
    "tap_element": ["session.session_id", "action.verb", "action.operation_id"],
    "type_text": ["session.session_id", "action.verb", "action.operation_id", "chars"],
    "press_key": ["session.session_id", "action.verb", "action.operation_id"],
    "acquire_control": ["session.session_id", "control.state", "control.holder.kind", "control.holder.id",
                        "control.holder.label", "control.generation", "control.expires_at", "control.mine",
                        "control.role", "control.took_over_from"],
    "release_control": ["session.session_id", "control.state", "control.holder", "control.generation",
                        "control.mine", "control.role"],
    "get_operation": ["session.session_id", "found", "entries[].verb", "entries[].ok", "entries[].at",
                      "entries[].error_code"],
    "list_flows": ["flows[].flow_id", "flows[].name", "flows[].root"],
    "start_flow_run": ["session.session_id", "run.run_id", "run.host_id", "run.session_id", "run.flow_id",
                       "run.flow_name", "run.status", "run.created_at", "run.steps.total", "run.steps.done",
                       "run.steps.failed", "run.current_step"],
    "get_run": ["run.run_id", "run.flow_name", "run.status", "run.created_at", "run.started_at", "run.ended_at",
                "run.steps.total", "run.steps.done", "run.steps.failed", "run.current_step", "run.exit_code",
                "run.error_code", "run.error", "run.reason", "run.report_artifacts"],
    "cancel_run": ["run.run_id", "run.status", "run.ended_at", "run.reason", "run.forced", "run.last_step_outcome"],
    "list_artifacts": ["session.session_id", "artifacts[].artifact_id", "artifacts[].kind", "artifacts[].name",
                       "artifacts[].group", "artifacts[].size", "artifacts[].modified_at", "artifacts[].mime"],
    "get_artifact": ["session.session_id", "artifact.artifact_id", "artifact.kind", "artifact.name",
                     "artifact.size", "artifact.mime", "artifact.offset", "artifact.length", "artifact.next_offset"],
    "open_stream": ["session.session_id", "stream.stream_id", "stream.session.host_id", "stream.session.session_id",
                    "stream.profile", "stream.state", "stream.width", "stream.height", "stream.codec",
                    "stream.epoch", "stream.buffer_bytes"],
    "get_frames": ["stream.stream_id", "stream.profile", "stream.state", "stream.width", "stream.height",
                   "stream.codec", "stream.epoch", "stream.buffer_bytes", "frames", "bytes", "first_seq", "last_seq",
                   "resync", "dropped", "server_ms"],
    "close_stream": ["closed"],
    "send_input": ["session.session_id", "input.op", "input.operation_id"],
    "pause_session": ["session.session_id", "control.state", "control.holder.kind", "control.holder.id",
                      "control.holder.label", "control.generation", "control.mine", "control.role",
                      "control.took_over_from"],
    "resume_session": ["session.session_id", "control.state", "control.holder", "control.generation",
                       "control.mine", "control.role"]
  },
  "meta": {
    "get_frames": ["autonom/frames.config_b64", "autonom/frames.frames[].seq", "autonom/frames.frames[].key",
                   "autonom/frames.frames[].pts", "autonom/frames.frames[].data_b64"],
    "get_artifact": ["autonom/artifact.data_b64"]
  },
  "refusals": {
    "tap_element": ["error_code", "error", "hint", "retry_safe", "control.state", "control.holder.kind",
                    "control.holder.id", "control.holder.label", "control.generation", "control.mine",
                    "control.role"]
  }
}
