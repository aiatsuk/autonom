{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autonom.dev/schemas/event-v1.schema.json",
  "title": "Autonom Event v1",
  "type": "object",
  "required": ["schema", "event_id", "run_id", "attempt_id", "sequence", "monotonic_ns", "wall_time", "source", "kind", "payload", "redaction"],
  "properties": {
    "schema": {"const": "autonom.event/v1"},
    "event_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "attempt_id": {"type": "string", "minLength": 1},
    "step_id": {"type": ["string", "null"]},
    "sequence": {"type": "integer", "minimum": 1},
    "monotonic_ns": {"type": "integer", "minimum": 0},
    "wall_time": {"type": "string", "format": "date-time"},
    "source": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "payload": {"type": "object"},
    "redaction": {
      "type": "object",
      "required": ["applied", "policy"],
      "properties": {
        "applied": {"const": true},
        "sensitive": {"type": "boolean"},
        "policy": {"const": "pre-persistence"}
      }
    }
  },
  "additionalProperties": true
}
